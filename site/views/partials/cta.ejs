<% if (home.cta && home.cta.enabled) { %>
<section class="cta">
  <% if (home.cta.background) { %>
    <div class="cta__bg" style="background-image:url('<%= esc(mediaUrl(home.cta.background)) %>')"></div>
  <% } %>
  <div class="container cta__inner">
    <h2 class="cta__title"><%= esc(home.cta.title) %></h2>
    <% if (home.cta.subtitle) { %>
      <p class="cta__subtitle"><%= esc(home.cta.subtitle) %></p>
    <% } %>
    <div class="cta__actions">
      <% if (home.cta.btnLabel) { %>
        <a class="btn btn--white btn--lg" href="<%= esc(home.cta.btnUrl) %>">
          <span><%= esc(home.cta.btnLabel) %></span>
          <svg viewBox="0 0 24 24" width="15" height="15"><use href="#i-arrow-right"></use></svg>
        </a>
      <% } %>
      <% if (home.cta.btnSecondaryLabel) { %>
        <a class="btn btn--ghost-w btn--lg" href="<%= esc(home.cta.btnSecondaryUrl) %>">
          <svg viewBox="0 0 24 24" width="15" height="15"><use href="#i-phone"></use></svg>
          <span><%= esc(home.cta.btnSecondaryLabel) %></span>
        </a>
      <% } %>
    </div>
  </div>
</section>
<% } %>
