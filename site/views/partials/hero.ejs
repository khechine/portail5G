<% if (home.hero && home.hero.enabled) { %>
<section class="hero" id="hero">
  <div class="hero__accent" aria-hidden="true"></div>
  <div class="hero__track">
    <% (home.hero.slides || []).forEach((slide, i) => { %>
    <div class="hero__slide<%= i === 0 ? ' is-active' : '' %>" <%= i === 0 ? '' : 'aria-hidden="true"' %>>
      <div class="container hero__inner">
        <div class="hero__content">
          <% if (slide.badge) { %>
            <span class="hero__badge">
              <span class="hero__dot" aria-hidden="true"></span>
              <%= esc(slide.badge) %>
            </span>
          <% } %>
          <h1 class="hero__title">
            <% if (slide.title) { %><%- nl2br(esc(slide.title)) %><% } %>
            <% if (slide.titleHighlight) { %><em><%- nl2br(esc(slide.titleHighlight)) %></em><% } %>
          </h1>
          <% if (slide.text) { %>
            <p class="hero__text"><%= esc(slide.text) %></p>
          <% } %>
          <% if (slide.btnPrimaryLabel) { %>
            <div class="hero__actions">
              <a class="btn btn--primary btn--lg" href="<%= esc(slide.btnPrimaryUrl) %>">
                <span><%= esc(slide.btnPrimaryLabel) %></span>
                <svg viewBox="0 0 24 24" width="15" height="15"><use href="#i-arrow-right"></use></svg>
              </a>
              <% if (slide.btnSecondaryLabel) { %>
                <a class="btn btn--ghost btn--lg" href="<%= esc(slide.btnSecondaryUrl) %>"><%= esc(slide.btnSecondaryLabel) %></a>
              <% } %>
            </div>
          <% } %>
        </div>
        <% if (slide.image) { %>
        <div class="hero__media">
          <img src="<%= mediaUrl(slide.image) %>" alt="<%= esc(config.siteName) %>">
        </div>
        <% } %>
      </div>
    </div>
    <% }) %>
  </div>

  <% if ((home.hero.slides || []).length > 1) { %>
    <button class="hero__nav hero__nav--prev" aria-label="prev">
      <svg viewBox="0 0 24 24" width="18" height="18" style="transform:scaleX(-1)"><use href="#i-arrow-right"></use></svg>
    </button>
    <button class="hero__nav hero__nav--next" aria-label="next">
      <svg viewBox="0 0 24 24" width="18" height="18"><use href="#i-arrow-right"></use></svg>
    </button>
    <div class="hero__dots">
      <% (home.hero.slides || []).forEach((_, i) => { %>
        <button class="hero__dot-btn<%= i === 0 ? ' is-active' : '' %>" data-slide="<%= i %>" aria-label="slide <%= i + 1 %>"></button>
      <% }) %>
    </div>
  <% } %>
</section>
<% } %>
